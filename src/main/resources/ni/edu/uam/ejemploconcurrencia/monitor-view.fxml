<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns:fx="http://javafx.com/fxml" styleClass="root"
            fx:controller="ni.edu.uam.ejemploconcurrencia.MonitorController"
            prefWidth="760" prefHeight="520">
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="10">
            <ImageView fx:id="logo" fitWidth="30" fitHeight="30" preserveRatio="true"/>
            <Label text="Descargas" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnNueva" text="Nueva descarga" onAction="#onNueva" styleClass="chip"/>
            <Button fx:id="btnIniciar" text="Iniciar todas" onAction="#onIniciar" styleClass="chip-primary"/>
            <Button fx:id="btnDetener" text="Cancelar" onAction="#onDetener" styleClass="chip-danger"/>
        </HBox>
    </top>
    <center>
        <ListView fx:id="lista" styleClass="downloads"/>
    </center>
    <bottom>
        <HBox styleClass="footer">
            <Label fx:id="lblEstado" text="Sin descargas activas."/>
        </HBox>
    </bottom>
</BorderPane>
